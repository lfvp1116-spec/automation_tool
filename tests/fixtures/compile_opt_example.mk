CC = iccarm.exe

CFLAGS += --cpu=Cortex-M4F
CFLAGS += --fpu=VFPv4-SP
CFLAGS += --thumb
CFLAGS += -Oh

CFLAGS += -DDET_DEBUG_ENABLED=STD_OFF
CFLAGS += -DINTEGRATION_TEST=0
CFLAGS += -DLK_DEBUG
CFLAGS += -DFEATURE_X=1

CC_DEFLIST_DEBUG = LK_DEBUG=1
CC_DEFLIST_RELEASE = LK_RELEASE=1
CC_DEFLIST_INTEGRATION = LK_INTEGRATION=1